<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="600"
        x:Class="demofinish.AddAgent_Window"
        x:CompileBindings="False"
        Title="Добавить агента">
    <DockPanel LastChildFill="True" Margin="10">
        <!-- Поля ввода -->
        <StackPanel DockPanel.Dock="Top" Spacing="8">
            <TextBox x:Name="NameBox" Watermark="Наименование*" />
            <ComboBox x:Name="TypeAgentCombobox">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBox x:Name="PriorityBox" Watermark="Приоритет*" />
            <TextBox x:Name="AddressBox" Watermark="Адрес*" />
            <TextBox x:Name="InnBox" Watermark="ИНН (10 цифр)*" />
            <TextBox x:Name="KppBox" Watermark="КПП (9 цифр)*" />
            <TextBox x:Name="DirectorBox" Watermark="Имя директора*" />
            <TextBox x:Name="PhoneBox" Watermark="Телефон*" />
            <TextBox x:Name="EmailBox" Watermark="Email*" />
            <TextBlock x:Name="ErrorTextBlock" Foreground="Red" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
            <Button Content="Добавить" Click="Add_Agent" />
            <Button Content="Отмена" Click="GoBack_Button" />
        </StackPanel>
    </DockPanel>
</Window>